# Copy to .env for local dev only. NEVER commit a real key.
# Production (Render): set these in the dashboard, not in a file.
PORT=3001
# Free CoinGecko Demo API key — get one at https://www.coingecko.com/en/api
# (free Demo plan, no credit card). Leave empty for local dev: the server
# then uses the local authd surrogate mechanism instead.
COINGECKO_API_KEY=
